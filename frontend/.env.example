# Copy this file to .env and fill in your values

# Supabase - get from https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# HuggingFace Space URL (no trailing slash)
# Format: https://YOUR_USERNAME-tea-disease-detector.hf.space
VITE_HUGGINGFACE_API_URL=https://your-username-tea-disease-detector.hf.space

# Only needed if your HuggingFace Space is private
# VITE_HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxx
